  var loadingMessages = [
    "Cruzando seus padrões de resposta...",
    "Localizando o que trava sua fala...",
    "Preparando seu diagnóstico Voz que Conecta..."
  ];

  var screenDisplay = { intro:"flex", quiz:"flex", loading:"flex", result:"block" };

  var state = { index:0, scores:{} };

  var screens = {
    intro: document.getElementById("screen-intro"),
    quiz: document.getElementById("screen-quiz"),
    loading: document.getElementById("screen-loading"),
    result: document.getElementById("screen-result")
  };
  var progressRow = document.getElementById("progress-row");
  var progressFill = document.getElementById("progress-fill");
  var progressCount = document.getElementById("progress-count");
  var qTitle = document.getElementById("q-title");
  var qOptions = document.getElementById("q-options");
  var quizToast = document.getElementById("quiz-toast");
  var btnBack = document.getElementById("btn-back");
  var stickyCta = document.getElementById("sticky-cta");
  var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var resultPageUrl = "anuncio1.html";

  function showScreen(name){
    Object.keys(screens).forEach(function(k){
      screens[k].style.display = (k === name) ? screenDisplay[k] : "none";
      screens[k].classList.toggle("active", k === name);
    });
    progressRow.classList.toggle("show", name === "quiz");
    stickyCta.classList.toggle("show", name === "result");
    window.scrollTo(0,0);
  }

  function showToast(msg){
    if(!quizToast) return;
    quizToast.textContent = msg;
    quizToast.classList.add("show");
    clearTimeout(showToast._t);
    showToast._t = setTimeout(function(){ quizToast.classList.remove("show"); }, 2600);
  }

  function renderQuestion(){
    var q = questions[state.index];
    qTitle.textContent = q.title;
    var countText = String(state.index+1).padStart(2,"0") + "/" + String(questions.length).padStart(2,"0");
    if(state.index === questions.length - 2){ countText += " · quase lá"; }
    progressCount.textContent = countText;
    progressFill.style.width = ((state.index) / questions.length * 100) + "%";
    btnBack.disabled = state.index === 0;
    quizToast.classList.remove("show");

    qOptions.innerHTML = "";
    qOptions.classList.remove("locked");
    q.options.forEach(function(opt){
      var b = document.createElement("button");
      b.className = "option";
      b.type = "button";
      b.setAttribute("data-level", opt.score);
      var bars = document.createElement("span");
      bars.className = "bars";
      for(var i=0;i<4;i++){ bars.appendChild(document.createElement("span")); }
      var label = document.createElement("span");
      label.textContent = opt.text;
      b.appendChild(bars);
      b.appendChild(label);
      b.addEventListener("click", function(){
        if(qOptions.classList.contains("locked")) return;
        qOptions.classList.add("locked");
        b.classList.add("selected");
        setTimeout(function(){
          selectAnswer(q.pillar, opt.score);
        }, reduceMotion ? 0 : 180);
      });
      qOptions.appendChild(b);
    });
  }

  function selectAnswer(pillarId, score){
    state.scores[pillarId] = score;
    if(state.index < questions.length - 1){
      state.index++;
      renderQuestion();
      if(toastMessages[state.index]){ showToast(toastMessages[state.index]); }
    } else {
      progressFill.style.width = "100%";
      finishQuiz();
    }
  }

  btnBack.addEventListener("click", function(){
    if(state.index > 0){
      state.index--;
      renderQuestion();
    }
  });

  function startQuiz(){
    state.index = 0;
    state.scores = {};
    showScreen("quiz");
    renderQuestion();
    logToSheet('QuizStart');
  }

  document.getElementById("btn-start").addEventListener("click", startQuiz);

  function finishQuiz(){
    showScreen("loading");
    startWave(document.getElementById("wave-loading"), 16);
    var loadingLabel = document.getElementById("loading-label");
    var step = 0;
    loadingLabel.textContent = loadingMessages[0];
    var msgInterval = setInterval(function(){
      step++;
      if(step < loadingMessages.length){
        loadingLabel.textContent = loadingMessages[step];
      }
    }, 480);
    setTimeout(function(){
      clearInterval(msgInterval);
      var id = pickPillar();
      logToSheet('QuizComplete_' + id);
      fbq('track', 'Lead');
      window.location.href = pillars[id].page;
    }, 1500);
  }

  function pickPillar(){
    var best = pillarOrder[0];
    var bestScore = -1;
    pillarOrder.forEach(function(id){
      var s = state.scores[id] || 0;
      if(s > bestScore){
        bestScore = s;
        best = id;
      }
    });
    return best;
  }

