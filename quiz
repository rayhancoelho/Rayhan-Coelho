<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0C0C0C;
    --bg-elevated:#1A1A1A;
    --bg-elevated-2:#141414;
    --text:#F7F2E9;
    --text-secondary:#A6A199;
    --accent:#FF8500;
    --accent-dim:#914C00;
    --line:#2B2B2B;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{-webkit-text-size-adjust:100%;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Manrope',sans-serif;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  img,svg,canvas{display:block;max-width:100%;}
  a{color:inherit;}
  button{font-family:inherit;}
  ::selection{background:var(--accent);color:#151008;}
  .wrap{max-width:640px;margin:0 auto;padding:0 20px;}
  h1,h2,h3{font-family:'Fraunces',serif;font-weight:600;letter-spacing:-0.01em;}
  em{color:var(--accent);font-style:normal;}
  .eyebrow{
    font-family:'Manrope',sans-serif;
    font-size:11px;
    font-weight:700;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--accent);
  }
  .btn{
    display:block;
    width:100%;
    text-align:center;
    background:var(--accent);
    color:#151008;
    font-family:'Manrope',sans-serif;
    font-weight:800;
    font-size:14.5px;
    letter-spacing:0.02em;
    text-transform:uppercase;
    padding:18px 20px;
    border-radius:8px;
    text-decoration:none;
    border:none;
    cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease;
    box-shadow:0 8px 24px -8px rgba(255,133,0,0.5);
  }
  .btn:active{transform:scale(.98);}
  @media (hover:hover){
    .btn:hover{transform:translateY(-2px);box-shadow:0 12px 28px -8px rgba(255,133,0,0.6);}
  }
  .btn-black{background:#000;color:var(--text);border:1px solid var(--line);box-shadow:none;}

  .reveal{opacity:0;transform:translateY(20px);transition:opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1);}
  .reveal.active{opacity:1;transform:translateY(0);}

  .screen{display:none;}
  section{padding:56px 0;}
  .divider{height:1px;background:var(--line);width:100%;}
  .bg-elevated{background:var(--bg-elevated);}
  .bg-elevated-2{background:var(--bg-elevated-2);}

  @media (prefers-reduced-motion: reduce){
    .reveal, .option, *{transition:none !important;animation:none !important;}
  }

  /* ---------- NAV ---------- */
  nav{
    position:fixed;top:0;left:0;right:0;z-index:50;
    padding:18px 0;
    transition:background .3s ease, border-color .3s ease, padding .3s ease;
  }
  nav.scrolled{
    background:rgba(12,12,12,0.85);
    -webkit-backdrop-filter:blur(10px);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
    padding:12px 0;
  }
  .nav-inner{display:flex;align-items:center;justify-content:space-between;}
  .nav-logo{font-family:'Fraunces',serif;font-size:16px;letter-spacing:-0.01em;}
  .nav-cta{
    display:inline-flex;align-items:center;gap:6px;
    padding:9px 16px;border-radius:999px;
    font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;
    background:var(--text);color:#0C0C0C;border:none;cursor:pointer;
  }

  /* ---------- INTRO ---------- */
  #screen-intro{
    min-height:100svh;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    position:relative;overflow:hidden;
    padding:110px 20px 60px;
    text-align:center;
  }
  .glow{
    position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);
    width:340px;height:340px;border-radius:50%;
    background:radial-gradient(circle at 35% 35%, rgba(255,133,0,0.28), rgba(255,133,0,0) 70%);
    filter:blur(2px);
    animation:breathe 6s ease-in-out infinite;
    pointer-events:none;
  }
  @keyframes breathe{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.7;}50%{transform:translate(-50%,-50%) scale(1.18);opacity:1;}}
  .intro-inner{position:relative;z-index:1;max-width:440px;}
  #screen-intro h1{font-size:clamp(28px,7.5vw,42px);line-height:1.14;margin:16px 0 16px;}
  #screen-intro .lead{color:var(--text-secondary);font-size:15.5px;max-width:380px;margin:0 auto 20px;}
  #screen-intro .lead .light{color:var(--text-secondary);opacity:.75;}
  .social-proof{
    font-size:11px;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.08em;
    margin-bottom:26px;
  }
  .social-proof strong{color:var(--accent);font-weight:700;}
  .intro-actions{display:flex;flex-direction:column;align-items:center;gap:12px;}
  #btn-start{max-width:340px;}
  .microcopy{font-size:10.5px;color:var(--text-secondary);opacity:.7;text-transform:uppercase;letter-spacing:0.08em;}
  #wave-intro-wrap{position:absolute;bottom:26px;left:0;right:0;display:flex;justify-content:center;opacity:.35;pointer-events:none;}

  /* ---------- QUIZ ---------- */
  #screen-quiz{min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding:100px 20px 60px;}
  .quiz-inner{max-width:420px;margin:0 auto;width:100%;}
  #progress-row{display:none;align-items:center;gap:10px;margin-bottom:26px;font-size:10.5px;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-secondary);}
  #progress-row.show{display:flex;}
  #progress-count{white-space:nowrap;font-variant-numeric:tabular-nums;}
  .progress-track{flex:1;height:3px;border-radius:999px;background:var(--line);overflow:hidden;}
  #progress-fill{height:100%;width:0;background:var(--accent);border-radius:999px;transition:width .3s ease;}
  #btn-back{background:none;border:none;color:var(--text-secondary);font-size:11px;text-transform:uppercase;letter-spacing:0.08em;cursor:pointer;margin-bottom:18px;padding:4px 0;}
  #btn-back:disabled{visibility:hidden;}
  #quiz-toast{
    font-size:12px;color:var(--accent);text-transform:uppercase;letter-spacing:0.06em;
    min-height:16px;margin-bottom:14px;opacity:0;transform:translateY(-4px);
    transition:opacity .25s ease, transform .25s ease;
  }
  #quiz-toast.show{opacity:1;transform:translateY(0);}
  #q-title{font-size:clamp(19px,5.4vw,24px);line-height:1.3;margin-bottom:22px;}
  #q-options{display:flex;flex-direction:column;gap:10px;}
  .option{
    display:flex;align-items:center;gap:13px;width:100%;text-align:left;
    background:var(--bg-elevated);border:1px solid var(--line);color:var(--text);
    padding:15px;border-radius:12px;font-size:14.5px;line-height:1.35;cursor:pointer;
    font-family:'Manrope',sans-serif;
    transition:border-color .15s ease, background .15s ease, transform .1s ease;
  }
  @media (hover:hover){
    .option:hover{border-color:rgba(255,133,0,0.4);background:#1f1f1f;}
  }
  .option.selected{border-color:var(--accent);background:#1f1f1f;transform:scale(.98);}
  .options.locked{pointer-events:none;}
  .bars{display:flex;align-items:flex-end;gap:3px;flex:0 0 auto;height:18px;}
  .bars span{width:3.5px;display:block;background:var(--line);border-radius:1px;}
  .bars span:nth-child(1){height:5px;}
  .bars span:nth-child(2){height:10px;}
  .bars span:nth-child(3){height:14px;}
  .bars span:nth-child(4){height:18px;}
  .option[data-level="1"] .bars span:nth-child(-n+1){background:var(--accent);}
  .option[data-level="2"] .bars span:nth-child(-n+2){background:var(--accent);}
  .option[data-level="3"] .bars span:nth-child(-n+3){background:var(--accent);}
  .option[data-level="4"] .bars span{background:#7a3a2a;}
  .option[data-level="4"] .bars span:nth-child(-n+4){background:var(--accent);}

  /* ---------- LOADING ---------- */
  #screen-loading{min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;padding:0 20px;text-align:center;}
  #loading-label{font-size:12px;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-secondary);}

  /* ---------- RESULT ---------- */
  #resultado{padding:100px 20px 48px;text-align:center;border-bottom:1px solid var(--line);}
  #resultado .eyebrow{margin-bottom:12px;display:block;}
  #verdict-title{font-family:'Fraunces',serif;font-style:italic;font-size:clamp(30px,9vw,44px);margin-bottom:14px;}
  #verdict-body{color:var(--text-secondary);font-size:14.5px;line-height:1.65;max-width:440px;margin:0 auto 12px;}
  #result-stat{font-size:11px;color:var(--text-secondary);opacity:.75;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:30px;}
  .meter{max-width:340px;margin:0 auto;}
  .meter-bar{height:6px;border-radius:999px;position:relative;background:linear-gradient(90deg,#FF8500 0%,#FF8500 35%,#c98a3f 60%,#7a2318 100%);}
  #meter-marker{position:absolute;top:-4px;width:2px;height:14px;background:var(--text);border-radius:1px;transition:left .9s cubic-bezier(.16,1,.3,1);}
  .meter-labels{display:flex;justify-content:space-between;margin-top:10px;font-size:9px;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);opacity:.7;}

  .quote-block{padding:56px 0;text-align:center;}
  .quote-block p{font-family:'Fraunces',serif;font-size:clamp(19px,5vw,25px);line-height:1.4;color:var(--text);}

  .pilar-grid{display:grid;grid-template-columns:1fr;gap:14px;}
  .pilar-card{background:var(--bg-elevated);border:1px solid var(--line);border-radius:16px;padding:24px;}
  .pilar-card .eyebrow{margin-bottom:10px;display:block;}
  .pilar-card h3{font-size:19px;margin-bottom:14px;}
  .pilar-card ul{list-style:none;display:flex;flex-direction:column;gap:10px;font-size:13.5px;color:var(--text-secondary);}
  .pilar-card ul li{display:flex;gap:10px;}
  .pilar-card ul li::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:7px;}
  .pilar-card.solve{background:var(--accent);color:#151008;}
  .pilar-card.solve .eyebrow{color:rgba(21,16,8,0.6);}
  .pilar-card.solve h3{color:#151008;}
  .pilar-card.solve p{font-size:13.5px;color:rgba(21,16,8,0.8);line-height:1.6;margin-bottom:10px;}
  .pilar-card.solve p:last-child{margin-bottom:0;}

  .section-title{text-align:center;font-size:clamp(22px,6vw,28px);margin-bottom:30px;}

  .use-grid{display:grid;grid-template-columns:1fr;gap:12px;}
  .use-card{background:var(--bg-elevated);border:1px solid var(--line);border-radius:12px;padding:18px 20px;}
  .use-card p.title{font-family:'Fraunces',serif;font-size:16px;margin-bottom:6px;}
  .use-card p.desc{font-size:13.5px;color:var(--text-secondary);}

  .testi-grid{display:grid;grid-template-columns:1fr;gap:12px;}
  .testi-card{background:var(--bg-elevated-2);border:1px solid var(--line);border-radius:12px;padding:18px 20px;opacity:0;transform:translateY(10px);transition:opacity .5s ease, transform .5s ease;}
  .testi-card.visible{opacity:1;transform:translateY(0);}
  .testi-card p{font-style:italic;font-size:13.5px;color:var(--text);line-height:1.55;margin-bottom:12px;}
  .testi-card span{font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-secondary);}

  .get-list{list-style:none;display:flex;flex-direction:column;gap:12px;font-size:14px;color:var(--text-secondary);max-width:400px;margin:0 auto;}
  .get-list li{display:flex;gap:10px;}
  .get-list li::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:8px;}

  .price-card{background:var(--accent);border-radius:20px;padding:32px 26px;color:#151008;text-align:center;max-width:380px;margin:0 auto;}
  .price-card .eyebrow{color:rgba(21,16,8,0.6);margin-bottom:10px;display:block;}
  .price-card h3{font-size:20px;margin-bottom:20px;color:#151008;}
  .price-card .amount{font-family:'Fraunces',serif;font-size:38px;font-weight:600;}
  .price-card .sub{font-size:13px;color:rgba(21,16,8,0.7);margin:4px 0 2px;}
  .price-card .note{font-size:10.5px;text-transform:uppercase;letter-spacing:0.06em;color:rgba(21,16,8,0.6);margin-bottom:24px;}
  .price-card ul{list-style:none;text-align:left;max-width:260px;margin:0 auto 22px;display:flex;flex-direction:column;gap:8px;font-size:13.5px;color:rgba(21,16,8,0.85);}
  .price-card .guarantee{font-size:10.5px;text-transform:uppercase;letter-spacing:0.06em;color:rgba(21,16,8,0.55);margin-top:14px;}

  .faq-item{border-bottom:1px solid var(--line);}
  .faq-q{
    width:100%;display:flex;justify-content:space-between;align-items:center;
    padding:18px 0;text-align:left;background:none;border:none;cursor:pointer;
    font-family:'Fraunces',serif;font-size:15.5px;color:var(--text);
  }
  .faq-icon{color:var(--accent);font-size:18px;transition:transform .2s ease;flex-shrink:0;margin-left:12px;}
  .faq-item.open .faq-icon{transform:rotate(45deg);}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;}
  .faq-item.open .faq-a{max-height:260px;}
  .faq-a p{font-size:13.5px;color:var(--text-secondary);line-height:1.6;padding-bottom:18px;}

  .about-block{text-align:center;}
  .about-avatar{width:64px;height:64px;border-radius:50%;overflow:hidden;margin:0 auto 20px;background:linear-gradient(155deg,var(--accent) 0%, var(--accent-dim) 100%);}
  .about-avatar img{width:100%;height:100%;object-fit:cover;}
  .about-block p{font-size:13.5px;color:var(--text-secondary);line-height:1.65;max-width:420px;margin:0 auto 14px;}
  .about-block p strong{color:var(--text);}
  .about-block .stat{font-size:10.5px;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-secondary);opacity:.7;}

  .final-block{text-align:center;padding-bottom:24px;}
  #cta-microcopy{font-size:11px;color:var(--accent);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:18px;}
  .final-block .guarantee{font-size:10.5px;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-secondary);opacity:.7;margin-top:14px;}
  #btn-retake{margin-top:30px;background:none;border:none;color:var(--text-secondary);font-size:11px;text-transform:uppercase;letter-spacing:0.06em;cursor:pointer;}

  footer{padding:48px 0 120px;border-top:1px solid var(--line);text-align:center;}
  footer .brand-mark{font-family:'Fraunces',serif;font-size:15vw;line-height:0.8;letter-spacing:-0.02em;color:rgba(247,242,233,0.04);font-weight:700;margin-bottom:26px;user-select:none;}
  footer .links{display:flex;flex-wrap:wrap;justify-content:center;gap:16px;font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-secondary);}

  #sticky-cta{
    display:none;
    position:fixed;bottom:0;left:0;right:0;z-index:40;
    background:rgba(12,12,12,0.92);
    -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
    border-top:1px solid var(--line);
    padding:12px 20px calc(12px + env(safe-area-inset-bottom));
  }
  #sticky-cta.show{display:block;}
  #sticky-cta .btn{padding:15px 20px;font-size:13px;}

  @media (min-width:600px){
    .pilar-grid, .use-grid, .testi-grid{grid-template-columns:1fr 1fr;}
  }
</style>
</head>
<body>

<main>

  <!-- INTRO -->
  <section id="screen-intro" class="screen active">
    <div class="glow" aria-hidden="true"></div>
    <div class="intro-inner">
      <p class="eyebrow reveal active">Diagnóstico · 3 minutos</p>
      <h1 class="reveal active" style="transition-delay:80ms">Qual é a <em>raiz</em> da sua timidez?</h1>
      <div class="intro-actions reveal active" style="transition-delay:150ms">
        <button id="btn-start" class="btn">Começar diagnóstico →</button>
      </div>
    </div>
    <div id="wave-intro-wrap"><canvas id="wave-intro" width="280" height="48" style="width:260px;height:44px;"></canvas></div>
  </section>

  <!-- QUIZ -->
  <section id="screen-quiz" class="screen">
    <div class="quiz-inner">
      <div id="progress-row">
        <span id="progress-count">01/09</span>
        <div class="progress-track"><div id="progress-fill"></div></div>
      </div>
      <button id="btn-back" disabled>← Voltar</button>
      <p id="quiz-toast"></p>
      <h2 id="q-title"></h2>
      <div id="q-options" class="options"></div>
    </div>
  </section>

  <!-- LOADING -->
  <section id="screen-loading" class="screen">
    <p id="loading-label">Cruzando seus padrões de resposta</p>
    <canvas id="wave-loading" width="180" height="44" style="width:180px;height:44px;"></canvas>
  </section>

  <!-- RESULT -->
  <section id="screen-result" class="screen">

    <div id="resultado" class="reveal">
      <div class="wrap">
        <span class="eyebrow">Seu diagnóstico</span>
        <p id="verdict-eyebrow" class="eyebrow" style="margin-top:6px;margin-bottom:16px;"></p>
        <h1 id="verdict-title"></h1>
        <p id="verdict-body"></p>
      </div>
    </div>

    <div class="quote-block reveal">
      <div class="wrap">
        <p>Isso normalmente não é falta de conteúdo ou de personalidade: é a <em>timidez travando esse ponto específico</em> antes dos outros.</p>
      </div>
    </div>

    <div class="wrap" style="padding-bottom:40px;">
      <div class="pilar-grid">
        <div class="pilar-card reveal">
          <span class="eyebrow">Você se identifica?</span>
          <h3 id="sintomas-title">Isso acontece com você</h3>
          <ul id="sintomas-list"></ul>
        </div>
        <div class="pilar-card solve reveal" style="transition-delay:100ms">
          <span class="eyebrow">Por onde começar</span>
          <h3 id="solve-title"></h3>
          <p id="solve-body"></p>
          <a id="cta-pilar" data-cta class="btn btn-black" style="margin-top:18px;">Ver como resolver →</a>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <section class="final-block">
      <div class="wrap">
        <p id="cta-microcopy"></p>
        <button data-cta class="btn" style="max-width:340px;margin:0 auto;">Quero resolver isso agora →</button>
        <p class="guarantee">Garantia incondicional de 7 dias</p>
        <button id="btn-retake">Refazer o diagnóstico</button>
      </div>
    </section>

  </section>
</main>

<div id="sticky-cta">
  <button data-cta class="btn">Ver meu resultado →</button>
</div>

<script>
(function(){
  "use strict";

  /* ======= URL do Apps Script (planilha) ======= */
  const SHEET_WEBHOOK_URL = 'https://script.google.com/macros/s/AKfycbzii4mp3EPFPfo-8O6ZRHQpvvllPo2UODqZvzBRnNME7KMtejzHVRF1-IZEM1iMOg/exec';
  /* ============================================== */

  function logToSheet(evento){
    if(!SHEET_WEBHOOK_URL || SHEET_WEBHOOK_URL.indexOf('COLE_AQUI') !== -1) return;
    fetch(SHEET_WEBHOOK_URL, {
      method:'POST', mode:'no-cors', headers:{ 'Content-Type':'text/plain' },
      body: JSON.stringify({ evento, pagina:'voc-quiz', data:new Date().toISOString() }),
    }).catch(()=>{});
  }

  logToSheet('PageView');

  var pillars = {
    presenca: {
      eyebrow: "Dá um branco bem na hora que você mais precisa",
