  var ctaButtons = document.querySelectorAll("[data-cta]");
  ctaButtons.forEach(function(btn){
    btn.addEventListener("click", function(e){
      if(btn.tagName === "A") return;
      window.location.href = resultPageUrl;
    });
  });

  /* ---------- social proof count-up ---------- */
  function animateCount(el, target, duration){
    if(!el) return;
    if(reduceMotion){
      el.textContent = target.toLocaleString("pt-BR");
      return;
    }
    var start = null;
    function step(ts){
      if(!start) start = ts;
      var progress = Math.min((ts-start)/duration, 1);
      var eased = 1 - Math.pow(1-progress, 3);
      el.textContent = Math.floor(eased*target).toLocaleString("pt-BR");
      if(progress < 1){ requestAnimationFrame(step); }
      else { el.textContent = target.toLocaleString("pt-BR"); }
    }
    requestAnimationFrame(step);
  }
  /* ---------- reveal on scroll ---------- */
  var revealObserver = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){ entry.target.classList.add("active"); }
    });
  }, { threshold:0.1, rootMargin:"0px 0px -50px 0px" });
  document.querySelectorAll(".reveal").forEach(function(el){ revealObserver.observe(el); });

  /* ---------- ambient waveform canvas ---------- */
  function startWave(canvas, barCount){
    if(!canvas) return;
    var ctx = canvas.getContext("2d");
    var dpr = window.devicePixelRatio || 1;

    function resize(){
      var rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.setTransform(dpr,0,0,dpr,0,0);
    }
    resize();
    window.addEventListener("resize", resize);

    var t = 0;
    function draw(){
      var rect = canvas.getBoundingClientRect();
      var w = rect.width, h = rect.height;
      ctx.clearRect(0,0,w,h);
      var gap = 4;
      var barW = (w - gap*(barCount-1)) / barCount;
      for(var i=0;i<barCount;i++){
        var phase = i * 0.55;
        var amp = reduceMotion ? 0.4 : (0.35 + 0.35 * Math.sin(t*0.06 + phase));
        var bh = Math.max(4, h * (0.15 + Math.abs(amp) * 0.65));
        var x = i * (barW + gap);
        var y = (h - bh) / 2;
        ctx.fillStyle = i % 5 === 0 ? "#FF8500" : "rgba(247,242,233,0.18)";
        ctx.fillRect(x, y, barW, bh);
      }
      t++;
      if(!reduceMotion){ requestAnimationFrame(draw); }
    }
    draw();
  }

  startWave(document.getElementById("wave-intro"), 24);
