    document.getElementById("verdict-body").textContent = p.body;
    document.getElementById("solve-title").textContent = p.solveTitle;
    document.getElementById("solve-body").textContent = p.solveBody;
    document.getElementById("cta-microcopy").textContent = p.cta;

    var sintomasList = document.getElementById("sintomas-list");
    sintomasList.innerHTML = "";
    p.sintomas.forEach(function(s){
      var li = document.createElement("li");
      li.textContent = s;
      sintomasList.appendChild(li);
    });

    document.getElementById("cta-pilar").href = p.page;
