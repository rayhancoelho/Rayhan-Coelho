<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Voz que Conecta — Diagnóstico</title>
<meta name="description" content="Descubra o que está travando sua fala por timidez. Diagnóstico gratuito de 3 minutos, por Rayhan Coelho.">
<meta name="theme-color" content="#0C0C0C">
