<script>
(function(){
  'use strict';

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold:.14 });
  document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });

  var heroCta = document.getElementById('hero-cta');
  var mcta = document.getElementById('mcta');
  if(heroCta && mcta){
    var ioBtn = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ mcta.classList.toggle('show', !e.isIntersecting); });
    }, { threshold:0 });
    ioBtn.observe(heroCta);
  }

  var steps = Array.prototype.slice.call(document.querySelectorAll('.jstep'));
  var railFill = document.getElementById('railFill');
  var stage = document.getElementById('stage');
  if(!steps.length || !stage) return;

  var data = [
    { n:'01', k:'Módulo 1', t:'Por que suas conversas morrem', l:[
      'O ciclo pergunta, resposta, pergunta',
      'O que está faltando entre uma pergunta e outra',
      'Uma conversa precisa de troca' ] },
    { n:'02', k:'Módulo 2', t:'O método R.A.C.', l:[
      'Reagir',
      'Acrescentar',
      'Continuar' ] },
    { n:'03', k:'Módulo 3', t:'Saindo do modo entrevista', l:[
      'Como parar de fazer perguntas mecânicas',
      'Como transformar respostas em novos caminhos' ] },
    { n:'04', k:'Módulo 4', t:'Conversas reais', l:[
      'Aplicando o R.A.C. no dia a dia' ] }
  ];

  var numEl = document.getElementById('stageNum');
  var countEl = document.getElementById('stageCount');
  var kickerEl = document.getElementById('stageKicker');
  var titleEl = document.getElementById('stageTitle');
  var lessonsEl = document.getElementById('stageLessons');
  var ticks = Array.prototype.slice.call(document.querySelectorAll('#stageTicks i'));
  var active = 0;

  function setActive(i){
    if(i === active || !data[i]) return;
    active = i;
    steps.forEach(function(s,k){ s.classList.toggle('is-active', k === i); });
    ticks.forEach(function(t,k){ t.classList.toggle('on', k <= i); });
    var d = data[i];
    numEl.textContent = d.n;
    countEl.textContent = d.n;
    kickerEl.textContent = d.k;
    titleEl.textContent = d.t;
    lessonsEl.innerHTML = d.l.map(function(x,idx){
      return '<li><b>' + String(idx+1).padStart(2,'0') + '</b>' + x + '</li>';
    }).join('');
  }

  var jio = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ setActive(parseInt(e.target.getAttribute('data-i'),10)); } });
  }, { rootMargin:'-45% 0px -45% 0px', threshold:0 });
  steps.forEach(function(s){ jio.observe(s); });

  var jornadaSection = document.querySelector('.jornada');
  if(railFill && jornadaSection){
    var ticking = false;
    var onScroll = function(){
      if(ticking) return; ticking = true;
      requestAnimationFrame(function(){
        var rect = jornadaSection.getBoundingClientRect();
        var total = jornadaSection.offsetHeight - window.innerHeight;
        var scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total,1));
        var frac = total > 0 ? scrolled/total : 0;
        railFill.style.transform = 'scaleY(' + frac + ')';
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive:true });
    window.addEventListener('resize', onScroll);
    onScroll();
  }
})();
</script>

