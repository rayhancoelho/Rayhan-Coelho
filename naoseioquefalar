<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Assunto · Voz que Conecta</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,600&display=swap" rel="stylesheet">
<style>
:root{
  --black:#0a0a0b; --black2:#151311;
  --accent:#E8631F; --accent-soft:rgba(232,99,31,0.12);
  --off:#EFEAE1; --dim:#aca69b; --grey:#736d63; --hair:rgba(255,255,255,0.1);
  --paper:#F4F0E8; --ink:#18160f; --ink-soft:#645f54; --ink-faint:#b9b3a5; --hair-soft:rgba(24,22,15,0.1);
  --font-sans:'Poppins',sans-serif; --font-serif:'Fraunces',serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto;}}
body{font-family:var(--font-sans);font-weight:300;color:var(--off);background:var(--black);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:clip;}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
.container{max-width:1180px;margin-inline:auto;padding-inline:44px;}
@media (max-width:900px){.container{padding-inline:22px;}}
section{position:relative;}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:18px;}
.eyebrow::before{content:'';width:18px;height:1px;background:var(--accent);}
h1,h2,h3{font-family:var(--font-serif);font-weight:500;color:var(--off);}
.dark h1,.dark h2,.dark h3{color:var(--off);}
.light h2,.light h3{color:var(--ink);}
em.hl{font-style:italic;color:var(--accent);font-weight:400;}
em.outline{font-style:italic;font-weight:500;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.4);}
p{font-size:16px;color:#d6d1c6;font-weight:300;}
.light p{color:var(--ink-soft);}
.btn{display:inline-flex;align-items:center;gap:12px;background:var(--accent);color:#0a0a0b;font-weight:600;font-size:13.5px;letter-spacing:.3px;text-transform:uppercase;padding:8px 8px 8px 24px;border-radius:999px;transition:background .25s,color .25s,transform .25s;}
.btn:hover{background:transparent;color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent);transform:translateY(-2px);}
.btn__ic{width:36px;height:36px;border-radius:50%;background:#0a0a0b;color:var(--accent);display:grid;place-items:center;flex-shrink:0;overflow:hidden;position:relative;}
.btn:hover .btn__ic{background:var(--accent);color:#0a0a0b;}
.btn__ic svg{transition:transform .3s cubic-bezier(.4,0,.2,1);}
.btn__ic svg.clone{position:absolute;transform:translateX(-140%);}
.btn:hover .btn__ic svg:not(.clone){transform:translateX(140%);}
.btn:hover .btn__ic svg.clone{transform:translateX(0);}
.btn-lg{padding:10px 10px 10px 30px;font-size:15px;}
.btn-lg .btn__ic{width:44px;height:44px;}
.microline{margin-top:14px;font-size:11.5px;letter-spacing:.4px;color:var(--grey);}

.reveal{opacity:0;transform:translateY(20px);filter:blur(6px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1),filter .8s cubic-bezier(.2,.7,.2,1);}
.reveal.in{opacity:1;transform:none;filter:blur(0);}
.reveal-fade{opacity:0;filter:blur(6px);transition:opacity .7s ease var(--d,0ms),filter .7s ease var(--d,0ms);}
.reveal-fade.in{opacity:1;filter:blur(0);}
@media (prefers-reduced-motion:reduce){.reveal,.reveal-fade{opacity:1!important;transform:none!important;filter:none!important;}}

header{position:sticky;top:0;z-index:40;background:rgba(10,10,11,.85);backdrop-filter:blur(10px);border-bottom:1px solid var(--hair);}
.nav{max-width:1180px;margin-inline:auto;padding:18px 44px;display:flex;align-items:center;justify-content:space-between;}
.brand{font-size:11.5px;letter-spacing:.25em;text-transform:uppercase;font-weight:600;}
.brand span{color:var(--accent);}
.nav-links{display:flex;gap:28px;list-style:none;}
.nav-links a{font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:400;position:relative;padding-bottom:3px;}
.nav-links a::after{content:'';position:absolute;left:0;bottom:0;width:100%;height:1px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .25s;}
.nav-links a:hover::after{transform:scaleX(1);}
@media (max-width:860px){.nav-links,.nav .btn{display:none;}.nav{padding:16px 22px;justify-content:center;}}

/* HERO */
.hero{border-bottom:1px solid var(--hair);background:linear-gradient(165deg,#1a1109 0%,#0a0a0b 65%);}
.hero__grid{display:grid;grid-template-columns:minmax(0,26rem) minmax(0,1fr);gap:40px;min-height:88vh;align-items:stretch;}
.hero__content{align-self:center;padding-block:40px;position:relative;z-index:1;}
.hero__ghost{position:absolute;left:-24px;top:50%;transform:translateY(-50%);font-family:var(--font-serif);font-weight:600;font-style:italic;font-size:min(24vw,260px);color:var(--off);opacity:.025;white-space:nowrap;pointer-events:none;z-index:0;line-height:1;}
.hero h1{font-size:clamp(30px,4vw,46px);line-height:1.14;letter-spacing:-.5px;max-width:520px;margin-bottom:22px;}
.hero__lead{max-width:420px;font-size:16.5px;color:var(--dim);margin-bottom:32px;}
.hero__media{position:relative;}
.hero__frame{position:absolute;inset:44px 0 0 0;overflow:hidden;}
.hero__frame::before{content:'';position:absolute;top:0;left:0;width:44px;height:44px;border-top:1px solid var(--accent);border-left:1px solid var(--accent);z-index:2;}
.hero__frame::after{content:'';position:absolute;bottom:0;right:0;width:44px;height:44px;border-bottom:1px solid var(--accent);border-right:1px solid var(--accent);z-index:2;}
.hero__frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 25%;}
.hero__quote{position:absolute;top:26px;right:0;z-index:3;width:180px;text-align:right;border-right:1px solid var(--accent);padding-right:18px;}
.hero__quote p{font-family:var(--font-serif);font-style:italic;font-size:14px;line-height:1.5;color:var(--off);}
.hero__quote cite{display:block;margin-top:8px;font-style:normal;font-weight:600;font-size:11.5px;color:var(--dim);}
.hero__pills{position:absolute;right:0;bottom:44px;z-index:3;display:flex;flex-direction:column;align-items:flex-end;gap:10px;}
.hero__pill{display:flex;align-items:center;gap:10px;padding:11px 18px;border-radius:999px;background:rgba(255,255,255,.05);backdrop-filter:blur(10px) saturate(160%);border:1px solid rgba(255,255,255,.08);font-size:13.5px;font-weight:500;white-space:nowrap;}
.hero__pill .dot{width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;}
.scroll-cue{position:absolute;left:22px;bottom:22px;z-index:3;width:96px;height:96px;border-radius:50%;background:rgba(255,255,255,.02);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.12);}
.scroll-cue svg.ring{width:100%;height:100%;animation:spin 18s linear infinite;}
.scroll-cue text{fill:var(--off);font-size:6.6px;letter-spacing:.24em;font-family:var(--font-sans);}
.scroll-cue .arrow{position:absolute;inset:0;margin:auto;width:18px;height:18px;color:var(--accent);animation:bob .9s ease-in-out infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
@keyframes bob{0%,100%{transform:translateY(0);}50%{transform:translateY(5px);}}
@media (max-width:900px){
  .hero__grid{grid-template-columns:1fr;min-height:auto;gap:0;}
  .hero__media{order:-1;height:58vh;}
  .hero__frame{inset:20px;}
  .hero__content{padding:44px 0;}
  .hero__ghost{display:none;}
  .scroll-cue{display:none;}
}

/* PROBLEMA */
.problema{background:var(--black);padding-block:110px;border-bottom:1px solid var(--hair);}
.problema__grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:64px;align-items:start;}
.problema__intro{position:sticky;top:100px;}
.problema__intro h2{font-size:2.4rem;line-height:1.15;margin:10px 0 18px;max-width:420px;}
.problema__intro p{max-width:400px;margin-bottom:26px;}
.problema__quote{border-left:2px solid var(--accent);padding:4px 0 4px 18px;font-family:var(--font-serif);font-style:italic;font-size:17px;line-height:1.5;max-width:380px;margin-bottom:30px;}
.signals{display:flex;flex-direction:column;gap:14px;}
.signal{display:grid;grid-template-columns:auto 1fr;gap:22px;border:1px solid var(--hair);border-radius:18px;padding:28px;transition:transform .4s cubic-bezier(.22,1,.36,1),border-color .4s,box-shadow .4s;}
.signal:hover{transform:translateX(8px);border-color:var(--accent);box-shadow:-10px 10px 0 -6px var(--accent);}
.signal__idx{writing-mode:vertical-rl;transform:rotate(180deg);font-size:10.5px;font-weight:600;letter-spacing:.16em;color:var(--grey);border-left:1px solid var(--hair);padding-left:12px;}
.signal h3{font-size:19px;margin-bottom:5px;}
.signal p{font-size:14px;margin:0;}
.signal__tag{display:inline-block;margin-top:12px;padding:5px 12px;border:1px solid var(--hair);border-radius:999px;font-size:11px;color:var(--grey);}
@media (max-width:900px){.problema{padding-block:64px;}.problema__grid{grid-template-columns:1fr;gap:0;}.problema__intro{position:static;margin-bottom:36px;}}

/* CONCEITO */
.conceito{background:radial-gradient(ellipse 90% 60% at 50% -10%,#221408,#0a0a0b 60%);padding-block:130px;overflow:hidden;border-bottom:1px solid var(--hair);}
.conceito__ghost{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);font-family:var(--font-serif);font-weight:700;font-size:min(30vw,420px);color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.035);white-space:nowrap;pointer-events:none;line-height:1;}
.conceito .container{position:relative;z-index:1;}
.conceito__statement{font-family:var(--font-sans);font-weight:600;font-size:clamp(1.7rem,4.4vw,2.9rem);letter-spacing:-.02em;line-height:1.16;max-width:820px;margin-bottom:56px;}
.conceito__map{border-top:1px solid var(--hair);}
.map-row{position:relative;overflow:hidden;display:grid;grid-template-columns:3rem 1fr auto 1fr;align-items:center;gap:24px;padding:30px 6px;border-bottom:1px solid var(--hair);}
.map-row::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent);transform:scaleY(0);transform-origin:top;transition:transform .4s cubic-bezier(.65,0,.35,1);}
.map-row:hover::before{transform:scaleY(1);}
.map-row .n{font-size:12px;font-weight:600;letter-spacing:.1em;color:var(--ink-faint);color:var(--grey);}
.map-row .a{font-family:var(--font-serif);font-size:clamp(1.1rem,2.6vw,1.5rem);}
.map-row .mid{display:flex;align-items:center;gap:10px;font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--grey);}
.map-row .mid svg{color:var(--accent);}
.map-row .b{font-family:var(--font-serif);font-weight:600;font-size:clamp(1.1rem,2.6vw,1.5rem);color:var(--accent);text-align:right;}
.conceito__close{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-top:56px;flex-wrap:wrap;}
.conceito__close p{max-width:520px;font-size:16.5px;line-height:1.6;}
@media (max-width:900px){
  .conceito{padding-block:70px;}
  .map-row{grid-template-columns:auto 1fr;grid-template-areas:'n a' '. mid' '. b';gap:6px 16px;padding:22px 4px 22px 16px;}
  .map-row .n{grid-area:n;}.map-row .a{grid-area:a;}.map-row .mid{grid-area:mid;}.map-row .b{grid-area:b;text-align:left;}
}

/* FORMAÇÃO (jornada sticky) */
.formacao{background:var(--black);padding:100px 0 40px;border-bottom:1px solid var(--hair);}
.formacao__head{max-width:640px;margin-bottom:16px;}
.formacao__head h2{font-size:2.4rem;margin-bottom:14px;}
.formacao__journey{display:grid;grid-template-columns:1fr .95fr;gap:60px;align-items:start;position:relative;}
.formacao__steps{padding-left:50px;position:relative;}
.formacao__rail{position:absolute;left:20px;top:0;bottom:0;width:2px;background:var(--hair);border-radius:2px;}
.formacao__rail-fill{position:absolute;left:0;top:0;width:100%;height:0;background:var(--accent);border-radius:2px;}
.f-step{position:relative;min-height:56vh;display:flex;flex-direction:column;justify-content:center;}
.f-step__dot{position:absolute;left:-38px;top:50%;transform:translateY(-50%) scale(.7);width:13px;height:13px;border-radius:50%;background:var(--black);border:2px solid var(--grey);transition:transform .5s cubic-bezier(.34,1.56,.64,1),background .4s,border-color .4s,box-shadow .4s;}
.f-step.is-active .f-step__dot{transform:translateY(-50%) scale(1.1);background:var(--accent);border-color:var(--accent);box-shadow:0 0 0 5px var(--accent-soft);}
.f-step__idx{font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--grey);margin-bottom:12px;transition:color .4s;}
.f-step.is-active .f-step__idx{color:var(--accent);}
.f-step__name{font-size:2.1rem;color:var(--grey);opacity:.5;transition:opacity .5s,color .5s;}
.f-step.is-active .f-step__name{color:var(--off);opacity:1;}
.f-step__teaser{margin-top:12px;max-width:360px;font-size:14.5px;color:var(--grey);opacity:0;transform:translateY(8px);filter:blur(3px);transition:opacity .5s,transform .5s,filter .5s;}
.f-step.is-active .f-step__teaser{opacity:1;transform:none;filter:blur(0);color:var(--dim);}
.formacao__stage{position:sticky;top:calc((100vh - 26rem)/2);}
.stage{position:relative;overflow:hidden;min-height:24rem;padding:44px 40px;border-radius:26px;background:radial-gradient(ellipse 120% 90% at 100% 0%,#2a1608,#100b06 60%);border:1px solid var(--hair);display:flex;flex-direction:column;justify-content:flex-end;}
.stage__num{position:absolute;top:-30px;right:6px;font-weight:700;font-size:9rem;color:transparent;-webkit-text-stroke:1px var(--accent-soft);line-height:1;pointer-events:none;}
.stage__top{position:absolute;top:26px;left:40px;right:40px;display:flex;align-items:center;gap:14px;}
.stage__count{font-size:11px;font-weight:600;letter-spacing:.1em;color:var(--dim);flex-shrink:0;}
.stage__count b{color:var(--accent);}
.stage__ticks{display:flex;gap:6px;flex:1;}
.stage__ticks i{position:relative;height:3px;flex:1;border-radius:3px;background:var(--hair);overflow:hidden;}
.stage__ticks i::after{content:'';position:absolute;inset:0;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .5s;}
.stage__ticks i.on::after{transform:scaleX(1);}
.stage__kicker{display:block;margin-bottom:12px;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);}
.stage__title{font-size:2rem;margin-bottom:12px;}
.stage__desc{max-width:400px;font-size:15px;color:var(--dim);margin-bottom:20px;}
.stage__tags{display:flex;flex-wrap:wrap;gap:8px;}
.stage__tags span{padding:7px 14px;border:1px solid var(--hair);border-radius:999px;font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);}
@media (max-width:900px){
  .formacao{padding:64px 0 20px;}
  .formacao__journey{grid-template-columns:1fr;gap:0;}
  .formacao__stage{order:-1;position:sticky;top:0;padding-top:14px;background:var(--black);z-index:2;}
  .stage{min-height:15rem;padding:62px 22px 26px;}
  .stage__top{left:22px;right:22px;top:22px;}
  .stage__num{font-size:5.5rem;top:-14px;}
  .stage__title{font-size:1.5rem;}
  .formacao__steps{padding-left:40px;margin-top:16px;}
  .formacao__rail{left:14px;}
  .f-step{min-height:32vh;}
  .f-step__dot{left:-32px;}
  .f-step__name{font-size:1.6rem;}
}

/* MODULOS */
.modulos{background:radial-gradient(ellipse 90% 60% at 50% -10%,#221408,#0a0a0b 55%);padding-block:110px;border-bottom:1px solid var(--hair);}
.modulos__head{max-width:640px;margin-bottom:50px;}
.modulos__head h2{font-size:2.4rem;margin-bottom:14px;}
.mod-list{display:flex;flex-direction:column;gap:14px;}
.mod{border:1px solid var(--hair);border-radius:18px;background:rgba(255,255,255,.015);overflow:hidden;transition:border-color .4s,background .4s;}
.mod.is-open{border-color:var(--accent-soft);background:rgba(232,99,31,.05);}
.mod__trigger{width:100%;display:flex;align-items:center;gap:20px;padding:24px 26px;background:none;border:none;cursor:pointer;text-align:left;color:inherit;font-family:inherit;}
.mod__num{flex-shrink:0;width:44px;font-family:var(--font-serif);font-size:26px;color:var(--accent);}
.mod__info{flex:1;min-width:0;}
.mod__label{display:block;font-size:10.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:4px;}
.mod__name{font-size:18px;font-weight:600;color:var(--off);font-family:var(--font-sans);}
.mod__meta{flex-shrink:0;display:flex;align-items:center;gap:16px;}
.mod__count{padding:5px 12px;border:1px solid var(--hair);border-radius:999px;font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--dim);white-space:nowrap;}
.mod__ic{width:34px;height:34px;border-radius:50%;border:1px solid var(--hair);background:rgba(255,255,255,.02);display:grid;place-items:center;transition:transform .4s,color .4s,border-color .4s,background .4s;}
.mod.is-open .mod__ic{transform:rotate(180deg);color:var(--accent);border-color:var(--accent-soft);background:var(--accent-soft);}
.mod__panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1);}
.mod.is-open .mod__panel{grid-template-rows:1fr;}
.mod__lessons{overflow:hidden;min-height:0;list-style:none;padding:2px 26px 24px 90px;}
.mod__lessons li{padding:11px 0;border-top:1px solid rgba(255,255,255,.06);font-size:14px;color:var(--dim);}
.mod__lessons li::before{content:'';display:inline-block;width:5px;height:5px;margin-right:12px;border-radius:50%;background:var(--accent);vertical-align:middle;}
.bonus-row{display:flex;gap:16px;flex-wrap:wrap;margin-top:26px;}
.bonus-chip{display:flex;align-items:center;gap:10px;padding:12px 18px;border:1px dashed var(--hair);border-radius:999px;font-size:13px;color:var(--dim);}
.bonus-chip b{color:var(--off);font-weight:500;}
@media (max-width:900px){
  .modulos{padding-block:64px;}
  .mod__trigger{padding:18px;gap:12px;}
  .mod__num{width:30px;font-size:19px;}
  .mod__name{font-size:15px;}
  .mod__count{display:none;}
  .mod__lessons{padding-left:18px;padding-right:18px;}
}

/* PARA QUEM */
.paraquem{background:var(--black);padding-block:110px;border-bottom:1px solid var(--hair);}
.paraquem__head{max-width:620px;margin-bottom:50px;}
.paraquem__head h2{font-size:2.4rem;}
.persona-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}
.persona{border:1px solid var(--hair);border-radius:20px;padding:30px 28px 26px;transition:transform .5s cubic-bezier(.22,1,.36,1),border-color .5s,box-shadow .5s;}
.persona.is-active{transform:translateY(-6px);border-color:var(--accent-soft);box-shadow:0 24px 46px -30px rgba(0,0,0,.6);}
.persona__num{font-size:11px;font-weight:600;letter-spacing:.1em;color:var(--grey);margin-bottom:14px;display:block;}
.persona__line{font-family:var(--font-serif);font-style:italic;font-size:19px;line-height:1.4;margin-bottom:16px;color:var(--off);}
.persona__out{display:flex;gap:10px;align-items:flex-start;padding-top:14px;border-top:1px dashed var(--hair);opacity:0;transform:translateY(6px);filter:blur(3px);transition:opacity .5s .08s,transform .5s .08s,filter .5s .08s;}
.persona.is-active .persona__out{opacity:1;transform:none;filter:blur(0);}
.persona__out svg{flex-shrink:0;color:var(--accent);margin-top:2px;}
.persona__out span{font-size:13.5px;color:var(--dim);line-height:1.4;}
@media (max-width:900px){.paraquem{padding-block:64px;}.persona-grid{grid-template-columns:1fr;}}

/* TRANSFORMAÇÃO */
.transf{background:linear-gradient(to bottom,var(--black) 0%,var(--black) 55%,var(--accent-soft) 100%);text-align:center;padding-block:130px;border-bottom:1px solid var(--hair);}
.tf-tag{font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:600;color:var(--grey);}
.tf-tag.after{color:var(--accent);}
.tf-txt{font-family:var(--font-serif);font-style:italic;font-size:clamp(22px,3.8vw,36px);line-height:1.35;max-width:680px;margin:18px auto 0;}
.tf-before .tf-txt{color:var(--grey);}
.tf-after .tf-txt{color:var(--off);}
.tf-div{display:flex;flex-direction:column;align-items:center;gap:8px;margin:48px 0;}
.tf-div .ln{width:1px;height:48px;background:var(--hair);overflow:hidden;position:relative;}
.tf-div .ln i{position:absolute;inset:0;background:var(--accent);transform:scaleY(0);transform-origin:top;transition:transform 1s ease;}
.tf-div.in .ln i{transform:scaleY(1);}
.tf-div svg{color:var(--accent);}
.transf .note{margin:50px auto 0;max-width:460px;font-size:13.5px;color:var(--grey);}
@media (max-width:900px){.transf{padding-block:70px;}}

/* SOBRE */
.sobre{background:radial-gradient(ellipse 90% 60% at 50% -10%,#221408,#0a0a0b 55%);padding-block:110px;border-bottom:1px solid var(--hair);}
.sobre__grid{display:grid;grid-template-columns:minmax(0,24rem) minmax(0,1fr);gap:60px;align-items:center;}
.sobre__photo{position:relative;aspect-ratio:4/5;border-radius:22px;overflow:hidden;border:1px solid var(--hair);}
.sobre__photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 25%;}
.sobre__badge{position:absolute;left:16px;bottom:16px;padding:12px 16px;border-radius:14px;background:rgba(10,10,11,.7);backdrop-filter:blur(8px);border:1px solid var(--hair);font-size:11px;color:var(--dim);}
.sobre__badge b{display:block;color:var(--accent);font-family:var(--font-serif);font-size:20px;}
.sobre__text{position:relative;}
.sobre__q{position:absolute;top:-40px;left:-6px;font-family:var(--font-serif);font-style:italic;font-size:96px;color:var(--accent);opacity:.16;line-height:1;}
.sobre__text h3{font-size:26px;margin-bottom:4px;position:relative;}
.sobre__role{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);margin-bottom:20px;position:relative;}
.sobre__text p{max-width:440px;font-size:15.5px;line-height:1.65;position:relative;}
@media (max-width:900px){.sobre{padding-block:64px;}.sobre__grid{grid-template-columns:1fr;gap:32px;}.sobre__photo{max-width:340px;}}

/* OFERTA */
.oferta{background:var(--paper);color:var(--ink);padding-block:120px;}
.oferta .eyebrow{color:var(--accent);}
.oferta .eyebrow::before{background:var(--accent);}
.oferta__head{max-width:600px;margin-bottom:50px;}
.oferta__head h2{font-size:2.4rem;color:var(--ink);}
.oferta__layout{display:grid;grid-template-columns:1.05fr .95fr;gap:26px;align-items:start;}
.stack{background:#fff;border:1px solid var(--hair-soft);border-radius:24px;padding:38px 34px;}
.stack__head{font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--hair-soft);}
.stack-item{display:flex;align-items:center;gap:16px;padding:16px 0;border-bottom:1px dashed var(--hair-soft);}
.stack-item:last-child{border-bottom:none;}
.stack-item__ic{width:38px;height:38px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;flex-shrink:0;}
.stack-item__tx{font-size:15px;color:var(--ink);}
.price-card{border:1px solid var(--hair-soft);border-radius:24px;padding:38px 34px;background:#fff;}
.price-card__tag{display:inline-flex;align-items:center;gap:8px;margin-bottom:22px;font-size:10.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);}
.price-card__tag i{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:blink 1.5s ease-in-out infinite;}
@keyframes blink{50%{opacity:.3;}}
.price-now{font-family:var(--font-serif);font-size:56px;color:var(--accent);line-height:1;margin-bottom:6px;}
.price-now sup{font-size:20px;font-weight:600;margin-right:4px;color:var(--ink-soft);}
.price-pay{font-size:13px;color:var(--ink-soft);margin-bottom:26px;}
.price-card .btn{width:100%;justify-content:space-between;}
@media (max-width:900px){.oferta{padding-block:70px;}.oferta__layout{grid-template-columns:1fr;}.stack,.price-card{padding:28px 22px;}}

/* FAQ */
.faq{background:var(--black);padding-block:110px;}
.faq__head{max-width:560px;margin:0 auto 44px;text-align:center;}
.faq__head h2{font-size:2.4rem;}
.faq-list{max-width:760px;margin-inline:auto;display:flex;flex-direction:column;gap:12px;}
.faqi{border:1px solid var(--hair);border-radius:16px;overflow:hidden;transition:border-color .35s;}
.faqi.is-open{border-color:var(--accent-soft);}
.faqi__trigger{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 22px;background:none;border:none;cursor:pointer;text-align:left;color:var(--off);font-family:var(--font-serif);font-size:16px;font-weight:500;}
.faqi__chev{flex-shrink:0;width:32px;height:32px;border-radius:50%;border:1px solid var(--hair);color:var(--dim);display:grid;place-items:center;transition:transform .4s,background .4s,color .4s,border-color .4s;}
.faqi.is-open .faqi__chev{transform:rotate(180deg);background:var(--accent);color:#0a0a0b;border-color:var(--accent);}
.faqi__panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .4s cubic-bezier(.22,1,.36,1);}
.faqi.is-open .faqi__panel{grid-template-rows:1fr;}
.faqi__panel p{overflow:hidden;min-height:0;padding:0 22px 20px;font-size:14px;color:var(--dim);}
@media (max-width:900px){.faq{padding-block:64px;}}

/* CTA final + footer */
.finalcta{padding:100px 0;text-align:center;background:var(--black);}
.finalcta h2{font-size:clamp(28px,4.4vw,42px);max-width:600px;margin:0 auto 32px;}
footer{background:var(--black);border-top:1px solid var(--hair);padding:50px 0 30px;}
.foot-top{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;padding-bottom:26px;border-bottom:1px solid var(--hair);flex-wrap:wrap;}
.foot-tag{margin-top:8px;font-size:12.5px;color:var(--grey);}
.foot-links{display:flex;gap:22px;flex-wrap:wrap;margin-top:22px;}
.foot-links a{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--grey);}
.foot-links a:hover{color:var(--accent);}
.foot-copy{margin-top:22px;font-size:11px;color:var(--grey);opacity:.7;}
</style>
</head>
