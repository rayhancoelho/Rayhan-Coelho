<script>
(function(){
  var els = Array.prototype.slice.call(document.querySelectorAll('.reveal, .reveal-fade'));
  if(!('IntersectionObserver' in window)){ els.forEach(function(el){el.classList.add('in');}); }
  else{
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold:.15, rootMargin:'0px 0px -60px 0px'});
    els.forEach(function(el){ io.observe(el); });
  }
})();

/* módulos accordion + auto-open on scroll */
(function(){
  var items = Array.prototype.slice.call(document.querySelectorAll('.mod'));
  if(!items.length) return;
  var triggers = items.map(function(it){ return it.querySelector('.mod__trigger'); });
  var panels = items.map(function(it){ return it.querySelector('.mod__panel'); });
  var open = -1;
  function close(i){ if(i<0) return; items[i].classList.remove('is-open'); triggers[i].setAttribute('aria-expanded','false'); }
  function openI(i){ if(i===open||i<0) return; close(open); open=i; items[i].classList.add('is-open'); triggers[i].setAttribute('aria-expanded','true'); }
  triggers.forEach(function(t,i){ t.addEventListener('click', function(){ if(i===open){ close(i); open=-1; } else { openI(i); } }); });
  if('IntersectionObserver' in window){
    var focused=-1;
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ var i=parseInt(e.target.getAttribute('data-i'),10); if(i!==focused){ focused=i; openI(i); } } });
    }, {rootMargin:'-45% 0px -45% 0px', threshold:0});
    items.forEach(function(it){ io.observe(it); });
  } else { openI(0); }
})();

/* faq accordion */
(function(){
  var items = Array.prototype.slice.call(document.querySelectorAll('.faqi'));
  if(!items.length) return;
  var triggers = items.map(function(it){ return it.querySelector('.faqi__trigger'); });
  var panels = items.map(function(it){ return it.querySelector('.faqi__panel'); });
  var open=-1;
  function close(i){ if(i<0) return; items[i].classList.remove('is-open'); triggers[i].setAttribute('aria-expanded','false'); }
  function openI(i){ close(open); open=i; items[i].classList.add('is-open'); triggers[i].setAttribute('aria-expanded','true'); }
  triggers.forEach(function(t,i){ t.addEventListener('click', function(){ if(i===open){ close(i); open=-1; } else { openI(i); } }); });
})();

/* formação: jornada sticky */
(function(){
  var section = document.querySelector('.formacao');
  if(!section) return;
  var steps = Array.prototype.slice.call(section.querySelectorAll('.f-step'));
  var railFill = section.querySelector('.formacao__rail-fill');
  var stage = section.querySelector('.stage');
  var bgNum = section.querySelector('.stage__num');
  var cnt = section.querySelector('.stage__count b');
  var kicker = section.querySelector('.stage__kicker');
  var title = section.querySelector('.stage__title');
  var desc = section.querySelector('.stage__desc');
  var tags = section.querySelector('.stage__tags');
  var ticks = Array.prototype.slice.call(section.querySelectorAll('.stage__ticks i'));
  if(!steps.length || !stage) return;

  var data = [
    {num:'01', title:'Por que você fica sem assunto', desc:'Entenda por que o problema geralmente não é falta de assunto, mas a tentativa de encontrar algo completamente novo para dizer.', tags:['Motivo real','Pensar demais','Pare de procurar']},
    {num:'02', title:'O método P.E.D.', desc:'Pegar, explorar e desenvolver: os três movimentos para transformar qualquer fala em uma oportunidade de continuar.', tags:['Pegar','Explorar','Desenvolver']},
    {num:'03', title:'Aplicando em conversas reais', desc:'O que fazer quando a pessoa responde pouco ou quando parece que o assunto acabou de vez.', tags:['Resposta curta','Sem forçar','Na prática']},
    {num:'04', title:'Situações do dia a dia', desc:'Como usar o método em encontros, amizades, faculdade, trabalho e com pessoas novas.', tags:['Encontros','Trabalho','Amizades']}
  ];

  var active = 0;
  function setActive(i){
    if(i===active || !data[i]) return;
    active = i;
    steps.forEach(function(s,k){ s.classList.toggle('is-active', k===i); });
    ticks.forEach(function(t,k){ t.classList.toggle('on', k<=i); });
    var d = data[i];
    bgNum.textContent = d.num;
    cnt.textContent = d.num;
    kicker.textContent = 'Módulo ' + d.num;
    title.textContent = d.title;
    desc.textContent = d.desc;
    tags.innerHTML = d.tags.map(function(x){ return '<span>'+x+'</span>'; }).join('');
  }

  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ setActive(parseInt(e.target.getAttribute('data-i'),10)); } });
    }, {rootMargin:'-45% 0px -45% 0px', threshold:0});
    steps.forEach(function(s){ io.observe(s); });
  }

  var railTicking=false;
  function onScroll(){
    if(railTicking) return; railTicking=true;
    requestAnimationFrame(function(){
      var rect = section.getBoundingClientRect();
      var total = section.offsetHeight - window.innerHeight;
      var scrolled = Math.min(Math.max(-rect.top,0), Math.max(total,1));
      var frac = total>0 ? scrolled/total : 0;
      if(railFill) railFill.style.height = (frac*100)+'%';
      railTicking=false;
    });
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
})();

/* para quem: scroll focus */
(function(){
  var cards = Array.prototype.slice.call(document.querySelectorAll('.persona'));
  if(!cards.length || !('IntersectionObserver' in window)) return;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ e.target.classList.toggle('is-active', e.isIntersecting); });
  }, {rootMargin:'-40% 0px -40% 0px', threshold:0});
  cards.forEach(function(c){ io.observe(c); });
})();

/* transformação: draw divider line */
(function(){
  var el = document.querySelector('.tf-div');
  if(!el || !('IntersectionObserver' in window)) return;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, {threshold:.4});
  io.observe(el);
})();
</script>
