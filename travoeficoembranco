<script>
(function(){
  'use strict';
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- nav reveal ---------- */
  var nav = document.getElementById('nav');
  var hero = document.getElementById('hero');
  if (nav && hero && 'IntersectionObserver' in window){
    new IntersectionObserver(function(entries){
      entries.forEach(function(e){ nav.classList.toggle('is-visible', !e.isIntersecting); });
    }, { threshold: .05 }).observe(hero);
  }

  /* ---------- generic reveal ---------- */
  var revealEls = document.querySelectorAll('.reveal, .reveal-l, .reveal-r');
  if (!reduced && 'IntersectionObserver' in window){
    var revealObs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); revealObs.unobserve(e.target); }
      });
    }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
    revealEls.forEach(function(el){ revealObs.observe(el); });
    setTimeout(function(){
      revealEls.forEach(function(el){ el.classList.add('in'); });
    }, 4500);
  } else {
    revealEls.forEach(function(el){ el.classList.add('in'); });
  }

  /* ---------- método: jornada sticky ---------- */
  (function(){
    var steps = Array.prototype.slice.call(document.querySelectorAll('.metodo__step'));
    if (!steps.length) return;

    var data = [
      { n: '01', title: 'Reconheça', desc: 'Você está se bloqueando. Só isso: perceber que está buscando a resposta perfeita em vez de simplesmente responder.' },
      { n: '02', title: 'Expresse',  desc: 'Comece pela primeira ideia honesta, mesmo que pareça incompleta ou mal formulada.' },
      { n: '03', title: 'Siga',      desc: 'Deixe a resposta se desenvolver enquanto você fala, a partir do que a outra pessoa disser ou perguntar em seguida.' }
    ];

    var stageNum = document.getElementById('stage-num');
    var stageCount = document.getElementById('stage-count');
    var stageTitle = document.getElementById('stage-title');
    var stageDesc = document.getElementById('stage-desc');
    var active = 0;

    function setActive(i){
      if (i === active || !data[i]) return;
      active = i;
      steps.forEach(function(s, k){ s.classList.toggle('is-active', k === i); });
      var d = data[i];
      stageNum.textContent = d.n;
      stageCount.textContent = d.n;
      stageTitle.textContent = d.title;
      stageDesc.textContent = d.desc;
    }

    steps[0].classList.add('is-active');

    if ('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting) setActive(parseInt(e.target.getAttribute('data-i'), 10));
        });
      }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
      steps.forEach(function(s){ io.observe(s); });
    }
  })();

  /* ---------- situações: foco por scroll ---------- */
  (function(){
    var items = document.querySelectorAll('.situ');
    if (!items.length || !('IntersectionObserver' in window)) {
      items.forEach(function(el){ el.classList.add('is-focus'); });
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ e.target.classList.toggle('is-focus', e.isIntersecting); });
    }, { rootMargin: '-35% 0px -35% 0px', threshold: 0 });
    items.forEach(function(el){ io.observe(el); });
  })();

  /* ---------- accordion factory ---------- */
  function accordion(itemSel, triggerSel, panelSel, exclusive){
    var items = Array.prototype.slice.call(document.querySelectorAll(itemSel));
    if (!items.length) return;
    var open = -1;
    items.forEach(function(item, i){
      var trigger = item.querySelector(triggerSel);
      trigger.addEventListener('click', function(){
        var isOpen = item.classList.contains('is-open');
        if (exclusive && open >= 0 && open !== i){
          items[open].classList.remove('is-open');
          items[open].querySelector(triggerSel).setAttribute('aria-expanded', 'false');
        }
        item.classList.toggle('is-open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
        open = isOpen ? -1 : i;
      });
    });
  }
  accordion('.modulo', '.modulo__trigger', '.modulo__panel', true);
  accordion('.faq-item', '.faq-item__trigger', '.faq-item__panel', true);
})();
</script>

